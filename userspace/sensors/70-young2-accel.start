#!/bin/sh
# 70-young2-accel.start
#
# Bring the K2HH accelerometer up at boot.
#
# WHY
#   CONFIG_SENSORS_K2HH=y is already in the kernel and the driver probes fine
#   ("[SENSOR]: k2hh_probe - chip id success 0x41"), but it comes up in
#   SUSPEND mode with enable=0, so raw_data reads 0,0,0 until something enables
#   it. Nothing in this userspace did, so the sensor was effectively dead to
#   applications even though the hardware worked.
#
#   The enable/poll_delay attributes live on the INPUT device, not on
#   /sys/class/sensors/accelerometer_sensor/ (which only has name/vendor/
#   raw_data/selftest/calibration/reactive_alert).
#
# SAMPLE RATE
#   200 ms = 5 Hz. That is plenty for orientation and screen rotation, and it
#   keeps the idle CPU cost negligible. The chip's ODR is set by the driver from
#   this value. Do not drop it to 10 ms unless something actually needs it.
#
# IDEMPOTENT: writing the same values twice is harmless.
#
# REVERT
#   rm /etc/local.d/70-young2-accel.start
#
# EVIDENCE / FULL ANALYSIS
#   drivers/sensors/documentation/2026-10-07_sensors/

DEV=/sys/class/input/event3/device
[ -e "$DEV/enable" ] || exit 0

# wait (bounded) for the input node to appear
i=0
while [ $i -lt 30 ] && [ ! -e "$DEV/enable" ]; do
	sleep 1
	i=$((i + 1))
done
[ -e "$DEV/enable" ] || exit 0

echo 200 > "$DEV/poll_delay" 2>/dev/null
echo 1   > "$DEV/enable"     2>/dev/null

exit 0
