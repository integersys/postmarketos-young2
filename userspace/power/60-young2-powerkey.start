#!/bin/sh
# 60-young2-powerkey.start
#
# Start the Young 2 power-button policy daemon.
#
# WHY THIS IS NEEDED
#   This kernel uses Android's wakelock/earlysuspend power model. Writing "mem" to
#   /sys/power/state only *requests* suspend, and NOTHING in this userspace clears the
#   suspended state again - so without a handler the phone would re-suspend forever.
#   On Android that job belongs to PowerManagerService. young2-powerkey.py is the
#   minimal equivalent: it watches the keypad and toggles suspend/wake on a short
#   power-button press, then makes sure the desktop is back.
#
# WHY "60-"
#   /etc/local.d runs *.start in lexical order. This only needs /dev/input/event0
#   (devtmpfs, available from sysinit) and Python. It does not depend on the GUI, but
#   starting it before the GUI is fine - it only reacts to key presses.
#
# IDEMPOTENT: refuses to start a second copy.
#
# REVERT
#   rm /etc/local.d/60-young2-powerkey.start
#   rm -f /usr/local/bin/young2-powerkey.py /run/young2-powerkey.state
#   (then kill the running daemon or reboot)
#
# EVIDENCE / FULL ANALYSIS
#   drivers/power/documentation/2026-10-06_power-management/

DAEMON=/usr/local/bin/young2-powerkey.py
[ -x "$DAEMON" ] || exit 0

# already running? nothing to do.
for p in /proc/[0-9]*; do
	c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null)
	case "$c" in
		*young2-powerkey.py*) exit 0 ;;
	esac
done

# wait (bounded) for the keypad node
i=0
while [ $i -lt 15 ] && [ ! -e /dev/input/event0 ]; do
	sleep 1
	i=$((i + 1))
done
[ -e /dev/input/event0 ] || exit 0

setsid python3 "$DAEMON" </dev/null >/dev/null 2>&1 &

exit 0
