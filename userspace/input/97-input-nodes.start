#!/bin/sh
# 97-input-nodes.start
#
# Create /dev/input/eventN for every registered input event device, plus /dev/uinput.
#
# WHY THIS IS NEEDED
#   Exactly the same cause as /dev/fb0:
#     - the running kernel is the 2016 vendor/downstream build with CONFIG_DEVTMPFS unset,
#       so the kernel cannot create device nodes itself;
#     - eudev is installed and enabled but /etc/init.d/udev start_pre() refuses to run
#       without devtmpfs and falls back to mounting plain tmpfs on /dev;
#     - therefore NOTHING is auto-populated and every node must be made by hand.
#   The historical /etc/local.d/y2dev.off did this, but it is disabled (".off") because the
#   device was converted to a headless/console setup on 2026-08-10.
#
#   Result before this script: /sys/class/input/event0..3 and /sys/class/misc/uinput existed,
#   /dev/input/ was an empty directory and /dev/uinput did not exist.
#
# MAJOR/MINOR
#   Always read from sysfs for the CURRENT boot. Never hardcode 13:64..13:67 or 10:223 -
#   those were only the observed values on 2026-09-17. Event minors are kernel-assigned.
#
# IDEMPOTENT: an existing node is left alone (never re-created over a live node).
#
# REVERT
#   rm /etc/local.d/97-input-nodes.start
#
# EVIDENCE / FULL ANALYSIS
#   documentation/2026-09-17_21-40_input-device-nodes-at-boot/
#   input.txt  (permanent reference)
#
# ORDERING: local.d runs files in lexical order. This file runs after
#   10-rndis-ssh-rescue.start and before 98-fb0-node.start and 99-ssh-pty-rndis.start.

mkdir -p /dev/input 2>/dev/null

# ---- one node per registered event device -----------------------------------
# Iterates over the sysfs entries the kernel actually created, so it adapts if the
# number of event devices or their minors changes.
for e in /sys/class/input/event*; do
	[ -e "$e" ] || continue
	n=$(basename "$e")
	d=$(cat "$e/dev" 2>/dev/null)
	[ -n "$d" ] || continue
	maj=${d%%:*}
	min=${d##*:}
	[ -n "$maj" ] && [ -n "$min" ] || continue
	if [ ! -e "/dev/input/$n" ]; then
		mknod "/dev/input/$n" c "$maj" "$min" 2>/dev/null
	fi
	chmod 666 "/dev/input/$n" 2>/dev/null
done

# ---- uinput -----------------------------------------------------------------
# Verified functional on this kernel (opens O_RDWR; a UI_DEV_CREATE/UI_DEV_DESTROY
# round trip registered and removed a virtual input device successfully).
# NOTE: UI_GET_VERSION does not exist here - it was added in Linux 3.17 and this is 3.10.17.
if [ -r /sys/class/misc/uinput/dev ]; then
	U=$(cat /sys/class/misc/uinput/dev 2>/dev/null)
	umaj=${U%%:*}
	umin=${U##*:}
	if [ -n "$umaj" ] && [ -n "$umin" ] && [ ! -e /dev/uinput ]; then
		mknod /dev/uinput c "$umaj" "$umin" 2>/dev/null
	fi
	[ -e /dev/uinput ] && chmod 666 /dev/uinput 2>/dev/null
fi

# ---- stable touchscreen symlink (match by device NAME, never by event number) ----
# The ist30xx touchscreen and its touchkeys live on one node. A stable symlink lets
# the Xorg InputDevice reference /dev/input/touchscreen instead of a kernel-assigned
# eventN that can change between boots.
for e in /sys/class/input/event*; do
	[ -e "$e" ] || continue
	n=$(basename "$e")
	inp="input${n#event}"
	nm=$(cat "/sys/class/input/$inp/name" 2>/dev/null)
	case "$nm" in
		ist30xx_ts_input)
			[ -e "/dev/input/$n" ] && ln -sf "/dev/input/$n" /dev/input/touchscreen 2>/dev/null
			;;
	esac
done

exit 0
