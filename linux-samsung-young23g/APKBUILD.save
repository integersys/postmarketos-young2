# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm/configs/(CHANGEME!)

maintainer=""
pkgname=linux-samsung-young23g
pkgver="3.10.17"
pkgrel=0
pkgdesc="Samsung Galaxy Young 2 kernel fork"
arch="armv7"
_carch="arm"
_flavor="samsung-young23g"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	git
	bash
	bc
	bison
	devicepkg-dev
	findutils
	flex
	openssl-dev
	perl
"

# Source
_config="config-$_flavor.$arch"
source="
        linux-samsung-young23g-e05a1c16fb7334378bb12d8116d0def2ef83ff0d.tar.gz::https://github.com/jnkcode/android_kernel_samsung_young23g/archive/e05a1c16fb7334378bb12d8116d0def2ef83ff0d.tar.gz
        $_config
        gcc7-give-up-on-ilog2-const-optimizations.patch
        gcc8-fix-put-user.patch
        gcc10-extern_YYLOC_global_declaration.patch
        kernel-use-the-gnu89-standard-explicitly.patch
"
builddir="$srcdir/android_kernel_samsung_young23g-e05a1c16fb7334378bb12d8116d0def2ef83ff0d"
_outdir="out"

prepare() {
	default_prepare
	. downstreamkernel_prepa}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"
}

