# Downstream kernel source recipe; see docs/building.md for validation limits.
pkgname=linux-samsung-young23g
pkgver=3.10.17
pkgrel=2
pkgdesc="Samsung Galaxy Young 2 downstream kernel for XFCE development"
arch="armv7"
url="https://github.com/jnkcode/android_kernel_samsung_young23g"
license="GPL-2.0-only"
makedepends="bash bc bison devicepkg-dev flex openssl-dev perl xz"
options="!check !strip !tracedeps"
_commit=e05a1c16fb7334378bb12d8116d0def2ef83ff0d
source="
    $pkgname-$pkgver.tar.gz::https://github.com/jnkcode/android_kernel_samsung_young23g/archive/$_commit.tar.gz
    config-xfce.armv7
    patches/0001-gcc15-compatibility.patch
    patches/0002-sprdfb-resume.patch
"
builddir="$srcdir/android_kernel_samsung_young23g-$_commit"

prepare() {
    default_prepare
    cp "$srcdir/config-xfce.armv7" "$builddir/.config"
}

build() {
    unset LDFLAGS
    local cross="${CROSS_COMPILE:-armv7-alpine-linux-musleabihf-}"
    make ARCH=arm CROSS_COMPILE="$cross" CC="${cross}gcc -msoft-float" olddefconfig
    make ARCH=arm CROSS_COMPILE="$cross" CC="${cross}gcc -msoft-float"
}

package() {
    local cross="${CROSS_COMPILE:-armv7-alpine-linux-musleabihf-}"
    install -Dm644 arch/arm/boot/zImage "$pkgdir/boot/vmlinuz-$pkgname"
    make ARCH=arm CROSS_COMPILE="$cross" CC="${cross}gcc -msoft-float" \
        modules_install INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1
    install -Dm644 include/config/kernel.release \
        "$pkgdir/usr/share/kernel/$pkgname/kernel.release"
}

