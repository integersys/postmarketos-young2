pkgname=linux-samsung-young23g
pkgver=3.10.17
pkgrel=1
pkgdesc="Linux kernel package for Samsung Galaxy Young 2"
arch="armv7"
_carch="arm"
_flavor="samsung-young23g"
_kernrel="3.10.17-samsung-young23g"
url="https://postmarketos.org"
license="GPL-2.0-only"
options="!check !archcheck !strip"
source=""

package() {
	mkdir -p "$pkgdir/boot"
	echo "kernel placeholder" > "$pkgdir/boot/vmlinuz-$_flavor"

	mkdir -p "$pkgdir/usr/lib/modules/$_kernrel"
	touch "$pkgdir/usr/lib/modules/$_kernrel/modules.order"
	touch "$pkgdir/usr/lib/modules/$_kernrel/modules.builtin"
	touch "$pkgdir/usr/lib/modules/$_kernrel/modules.dep"
}

sha512sums=""