
# Kernel for Samsung Galaxy Young 2 (SM-G130)
# Downstream 3.10 kernel from CyanogenMod 12.1
pkgname=linux-samsung-young23g
pkgver=3.10.17
pkgrel=0
pkgdesc="Samsung Galaxy Young 2 downstream kernel"
arch="armv7"
url="https://github.com/jnkcode/android_kernel_samsung_young23g"
license="GPL-2.0-only"
makedepends="bash bc bison devicepkg-dev flex git openssl-dev perl"
options="!check !strip !tracedeps"
source="
    $pkgname-$pkgver.tar.gz::https://github.com/jnkcode/android_kernel_samsung_young23g/archive/e05a1c16fb7334378bb12d8116d0def2ef83ff0d.tar.gz
    config-$pkgname.armv7
    gcc7-give-up-on-ilog2-const-optimizations.patch
    gcc8-fix-put-user.patch
    gcc10-extern_YYLOC_global_declaration.patch
    kernel-use-the-gnu89-standard-explicitly.patch
    ARM-8933-1-replace-Sun-Solaris-style-flag-on-section.patch
"
builddir="$srcdir/android_kernel_samsung_young23g-e05a1c16fb7334378bb12d8116d0def2ef83ff0d"

prepare() {
    default_prepare
    cd "$builddir"
    cp include/linux/compiler-gcc4.h include/linux/compiler-gcc15.h
    echo 'int main(void){return 0;}' > scripts/sortextable.c
    cp "$srcdir/config-$pkgname.armv7" .config
    
   
    sed -i 's/#alloc, #execinstr/"ax"/g' arch/arm/boot/compressed/*.S
    sed -i 's/#alloc/"a"/g' arch/arm/boot/compressed/*.S
}

build() {
    cd "$builddir"
    unset LDFLAGS
    export CROSS_COMPILE="armv7-alpine-linux-musleabihf-"
    export ARCH="arm"
    export LOCALVERSION="-pmos"
   
    sed -i 's|/home/cakl/toolchain/bin/arm-eabi-||g' Makefile
    make olddefconfig
    make -j$(nproc)
}

package() {
    cd "$builddir"
    install -Dm644 arch/arm/boot/zImage "$pkgdir/boot/vmlinuz-$pkgname"
    make modules_install INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1
}

